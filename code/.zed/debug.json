// Generic debug config: every program builds to the fixed path bin/main,
// so this works for any program folder. It assumes the open file lives one
// level below the program root (src/ or include/).
// Edit only "args" to change the program's arguments.
[
  {
    "label": "Debug program",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": "Build",
    "program": "$ZED_DIRNAME/../bin/main",
    "args": [
      "ONE",
      "2",
      "tre"
    ],
    "cwd": "$ZED_DIRNAME/.."
  },
  {
    // For test executables: open the test source (e.g. test/test_core.c)
    // and launch this — $ZED_STEM resolves to the binary name (bin/test_core).
    "label": "Debug test",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": "Build",
    "program": "$ZED_DIRNAME/../bin/$ZED_STEM",
    "cwd": "$ZED_DIRNAME/.."
  }
]
