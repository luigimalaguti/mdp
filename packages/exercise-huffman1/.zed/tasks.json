[
  {
    "label": "Run huffman1 compression",
    "command": "make rebuild && bin/huffman1",
    "args": [
      "c",
      "inputs/example_plain.txt",
      "outputs/example_plain.h1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/packages/exercise-huffman1",
  },
  {
    "label": "Run huffman1 decompression",
    "command": "make rebuild && bin/huffman1",
    "args": [
      "d",
      "outputs/example_encoded.h1",
      "inputs/example_encoded.txt"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/packages/exercise-huffman1",
  },
]
