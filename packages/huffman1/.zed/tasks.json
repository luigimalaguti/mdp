[
  {
    "label": "Run huffman1 compression",
    "command": "make rebuild && bin/huffman1",
    "args": [
      "c",
      "inputs/example.txt",
      "outputs/example.h1"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/packages/huffman1",
  },
  {
    "label": "Run huffman1 decompression",
    "command": "make rebuild && bin/huffman1",
    "args": [
      "d",
      "outputs/example.h1",
      "inputs/example.txt"
    ],
    "cwd": "$ZED_WORKTREE_ROOT/packages/huffman1",
  },
]
