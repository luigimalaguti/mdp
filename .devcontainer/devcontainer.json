{
  "name": "devcontainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "target": "cpp"
  },
  "remoteUser": "dev",
  "runArgs": [
    "--name",
    "mdp"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,consistency=cached,readonly",
    "source=/run/host-services/ssh-auth.sock,target=/ssh-agent,type=bind"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/ssh-agent"
  }
}
